// 既定値を上書きするには、このファイル内にキー バインドを挿入します
[
    {
        "key": "ctrl+[BracketLeft]",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+shift+[BracketLeft]",
        "command": "-workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+[Semicolon] e",
        "command": "-testing.reRunFailTests"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+shift+i",
        "command": "-testing.toggleInlineCoverage"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+i",
        "command": "-testing.toggleInlineTestOutput"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+c",
        "command": "-testing.debugAtCursor",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+[Semicolon] c",
        "command": "-testing.runAtCursor",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+shift+l",
        "command": "-testing.coverageLastRun"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+shift+c",
        "command": "-testing.coverageAtCursor",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+shift+a",
        "command": "-testing.coverageAll"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+a",
        "command": "-testing.debugAll"
    },
    {
        "key": "ctrl+[Semicolon] a",
        "command": "-testing.runAll"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+r",
        "command": "-testing.refreshTests",
        "when": "testing.canRefresh"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+x",
        "command": "-testing.cancelRun"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+shift+f",
        "command": "-testing.coverageCurrentFile",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+f",
        "command": "-testing.debugCurrentFile",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+[Semicolon] f",
        "command": "-testing.runCurrentFile",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+l",
        "command": "-testing.debugLastRun"
    },
    {
        "key": "ctrl+[Semicolon] l",
        "command": "-testing.reRunLastRun"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+e",
        "command": "-testing.debugFailTests"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+o",
        "command": "-testing.showMostRecentOutput",
        "when": "testing.hasAnyResults"
    },
    {
        "key": "ctrl+[Semicolon] ctrl+m",
        "command": "-testing.openOutputPeek"
    },
    {
        "key": "ctrl+shift+[Semicolon]",
        "command": "-workbench.action.browser.zoomIn",
        "when": "browserFocused && browserHasUrl && !browserHasError && activeEditor == 'workbench.editor.browser'"
    },
    {
        "key": "ctrl+shift+[Semicolon]",
        "command": "-workbench.action.zoomIn"
    },
    {
        "key": "ctrl+alt+down",
        "command": "-workbench.action.chat.nextUserPrompt",
        "when": "chatIsEnabled && inChat"
    },
    {
        "key": "ctrl+alt+down",
        "command": "-quickInput.nextSeparator",
        "when": "inQuickInput && quickInputType == 'quickPick' || inQuickInput && quickInputType == 'quickTree'"
    },
    {
        "key": "shift+alt+down",
        "command": "editor.action.copyLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+shift+alt+down",
        "command": "-editor.action.copyLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "shift+alt+up",
        "command": "editor.action.copyLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+shift+alt+up",
        "command": "-editor.action.copyLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+alt+pageup",
        "command": "-workbench.action.chat.previousCodeBlock",
        "when": "chatIsEnabled && inChat"
    },
    {
        "key": "ctrl+alt+up",
        "command": "-workbench.action.chat.previousUserPrompt",
        "when": "chatIsEnabled && inChat"
    },
    {
        "key": "ctrl+alt+down",
        "command": "editor.action.insertCursorBelow",
        "when": "editorTextFocus"
    },
    {
        "key": "shift+alt+down",
        "command": "-editor.action.insertCursorBelow",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+alt+up",
        "command": "editor.action.insertCursorAbove",
        "when": "editorTextFocus"
    },
    {
        "key": "shift+alt+up",
        "command": "-editor.action.insertCursorAbove",
        "when": "editorTextFocus"
    }
]
